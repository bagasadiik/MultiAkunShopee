# =========================================================================
# Shopee Open Platform credentials
# Daftarkan aplikasi di https://open.shopee.com lalu salin Partner ID & Key.
# =========================================================================

# Partner ID (angka) dari Shopee Open Platform
SHOPEE_PARTNER_ID=

# Partner Key / App Key (string panjang) — RAHASIA, jangan dibagikan
SHOPEE_PARTNER_KEY=

# Host API Shopee.
#  - Produksi (live)  : https://partner.shopeemobile.com
#  - Sandbox (test)   : https://partner.test-stable.shopeemobile.com
SHOPEE_HOST=https://partner.shopeemobile.com

# Redirect/callback URL. HARUS sama persis dengan yang didaftarkan
# di menu "Set Redirect URL" pada Shopee Open Platform.
SHOPEE_REDIRECT_URL=http://localhost:3000/auth/callback

# Region default toko (id, sg, my, th, vn, ph, tw, br). Hanya untuk label.
SHOPEE_REGION=id

# Port server lokal
PORT=3000

# Folder penyimpanan data (relatif terhadap root project)
DATA_DIR=data

# Backend penyimpanan token:
#   - file   : simpan ke data/accounts.json (default, jalan di semua versi Node)
#   - sqlite : simpan ke database SQLite via modul bawaan node:sqlite
#              (butuh Node.js 22.5+; tanpa dependency tambahan)
STORE_DRIVER=file

# Lokasi file database SQLite (dipakai saat STORE_DRIVER=sqlite).
# Default: <DATA_DIR>/accounts.db
# DB_PATH=data/accounts.db
